# ==============================================================================
# FITNESS PLATFORM (PHASE 1) - ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL PRIVILEGED SECRETS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SAFE CONFIGURATION (Exposed in browser bundle via Vite)
# Rule: Must have VITE_ prefix. Contains browser-safe public credentials ONLY.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=

# Firebase Web Configuration (Client Delivery & Hosting)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (Supabase Edge Functions / Vault ONLY)
# Rule: NEVER prefix with VITE_. NEVER import in React or client code.
# ------------------------------------------------------------------------------
SUPABASE_SECRET_KEY=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
APP_SECRET_KEY=
